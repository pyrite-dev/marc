# GENERIC kernel for mac68k (Macintosh 128K, 512K and Plus)

machine	mac68k
ident	GENERIC

makeoptions CC="m68k-apple-macos-gcc"
makeoptions CFLAGS="-m68000 -Os -ffreestanding -fno-builtin -fno-stack-protector -fno-pic -Wall -Wno-array-bounds"

makeoptions AS="m68k-apple-macos-as"
makeoptions ASFLAGS="-m68000"

makeoptions LD="m68k-apple-macos-ld"
makeoptions LDFLAGS=""

makeoptions AR="m68k-apple-macos-ar"
makeoptions ARFLAGS="rcs"

makeoptions OBJCOPY="m68k-apple-macos-objcopy"
makeoptions OCFLAGS=""

makeoptions STRIP="m68k-apple-macos-strip"

makeoptions CPP="m68k-apple-macos-cpp"
makeoptions CPPFLAGS=""

makeoptions KERNEL="kernel"
makeoptions FLOPPY="floppy.img"

mainbus0	at root
via0		at mainbus0 addr 0xefe1fe stride 512 irq 1 speed 200 clock 392000
macfb0		at mainbus0
scc0		at mainbus0 addr 0x9ffff8 port 0xbffff9 irq 2 clock 3672000 baud 9600

include "mach/mac68k/conf/files.mac68k"
include "dev/files.dev"
